# Copy this file to .env and edit the copy. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INDEX_DIR=data/indexes

# LLM (Phase 3). Provider is "ollama" (real local model) or "mock" (labeled fake)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_NUM_CTX=8192
# Evidence gate (tune with: python scripts\ask.py ... --scores)
QA_MIN_COSINE=0.30
QA_MIN_KEYWORD_SCORE=8.0
QA_MAX_EVIDENCE=5
# LLM (Phase 3). Provider is "ollama" (real local model) or "mock" (labeled fake)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_NUM_CTX=8192
# Evidence gate (tune with: python scripts\ask.py ... --scores)
QA_MIN_COSINE=0.30
QA_MIN_KEYWORD_SCORE=8.0
QA_MAX_EVIDENCE=5

# Answer validation (Phase 5)
VALIDATION_MIN_VALID_CITATIONS=1
VALIDATION_MIN_STRONG_EVIDENCE=1
VALIDATION_MIN_COSINE=0.30
VALIDATION_MIN_KEYWORD_SCORE=8.0
VALIDATION_MIN_SUPPORTED_FRACTION=0.5
VALIDATION_MAX_UNSUPPORTED_FACTS=0
VALIDATION_FACT_ANCHOR_COVERAGE=0.8
VALIDATION_INFERENCE_ANCHOR_COVERAGE=0.5
VALIDATION_WORD_COVERAGE=0.4
VALIDATION_JUDGE=on
VALIDATION_JUDGE_MAX_CLAIMS=10
EVAL_LOG_ENABLED=on
EVAL_LOG_PATH=data/logs/evaluations.jsonl
EVAL_LOG_CODE=off


# Graph expansion (Phase 4)
GRAPH_EXPAND_DEPTH=1
GRAPH_EXPAND_MAX_PER_DIRECTION=2
GRAPH_EXPAND_MAX_ADDED=4
GRAPH_EXPAND_MAX_SEEDS=3

# Graph expansion (Phase 4)
GRAPH_EXPAND_DEPTH=1
GRAPH_EXPAND_MAX_PER_DIRECTION=2
GRAPH_EXPAND_MAX_ADDED=4
GRAPH_EXPAND_MAX_SEEDS=3

# Sandbox (Phase 6)
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_OUTPUT_KB=200
SANDBOX_MAX_COPY_MB=50
SANDBOX_MAX_FILES=3000
SANDBOX_ALLOW_LOOPBACK=off
