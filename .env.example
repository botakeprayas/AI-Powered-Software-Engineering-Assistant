# Copy this file to .env and edit the copy. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INDEX_DIR=data/indexes

# LLM (Phase 3). Provider is "ollama" (real local model) or "mock" (labeled fake)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_NUM_CTX=8192
# Evidence gate (tune with: python scripts\ask.py ... --scores)
QA_MIN_COSINE=0.30
QA_MIN_KEYWORD_SCORE=8.0
QA_MAX_EVIDENCE=5
# LLM (Phase 3). Provider is "ollama" (real local model) or "mock" (labeled fake)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_NUM_CTX=8192
# Evidence gate (tune with: python scripts\ask.py ... --scores)
QA_MIN_COSINE=0.30
QA_MIN_KEYWORD_SCORE=8.0
QA_MAX_EVIDENCE=5
